# ---------- Stage 1: Build dependencies ----------
# assisted-by Codex Codex-sonnet-4-6
FROM python:3.13-slim AS builder

ARG AGENT_NAME

RUN if [ -z "$AGENT_NAME" ]; then \
    echo "Error: AGENT_NAME build argument is required but not set."; \
    exit 1; \
    fi

# Install system dependencies and uv in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    tzdata \
    && pip install uv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Mirror the source-tree layout under /app so that relative path sources in
# `[tool.uv.sources]` (e.g. `mcp-agent-auth = { path = "../common/mcp-auth" }`)
# resolve inside the project base directory. uv refuses to follow `..` paths
# that escape the project root, so we keep the `mcp/<name>` + sibling
# `mcp/common` layout intact rather than flattening into the image.
COPY --chown=root:root ./ai_platform_engineering/mcp/${AGENT_NAME} \
     /app/ai_platform_engineering/mcp/${AGENT_NAME}/
COPY --chown=root:root ./ai_platform_engineering/mcp/common \
     /app/ai_platform_engineering/mcp/common/

WORKDIR /app/ai_platform_engineering/mcp/${AGENT_NAME}

# Keep the dependency environment outside the source tree. Dev compose bind
# mounts each MCP source directory and would otherwise hide the image-built venv.
ENV UV_PROJECT_ENVIRONMENT=/opt/caipe-mcp-venvs/${AGENT_NAME}

# Install dependencies into venv (no dev deps)
# Increase timeout for large packages (e.g., pyarrow 39MB) and to absorb
# stalled TCP streams when docker compose builds 20+ images in parallel.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=900 uv sync --locked --no-dev

# ---------- Stage 2: Final runtime image ----------
# Wolfi (Chainguard) base: 0 CVEs, continuously patched packages, replaces
# python:3.13-slim to eliminate the ~300 Debian system-package CVEs per image.
FROM cgr.dev/chainguard/wolfi-base

ARG AGENT_NAME

RUN if [ -z "$AGENT_NAME" ]; then \
    echo "Error: AGENT_NAME build argument is required but not set."; \
    exit 1; \
    fi

# Override APK repo to public Wolfi OS packages (no auth required).
# cgr.dev/chainguard/wolfi-base defaults to apk.cgr.dev/chainguard which
# requires Chainguard credentials; packages.wolfi.dev/os is free and public.
ARG INSTALL_NETUTILS=false
ARG INSTALL_AWS_CLI=false
ARG INSTALL_KUBECTL=false

RUN echo "https://packages.wolfi.dev/os" > /etc/apk/repositories && \
    for i in 1 2 3; do apk add --no-cache python-3.13 shadow tzdata && break; [ $i -lt 3 ] && sleep $((i * 5)); done && \
    if [ "$INSTALL_NETUTILS" = "true" ]; then \
        for i in 1 2 3; do \
            apk add --no-cache \
                bind-tools iputils whois curl iproute2 net-tools \
                dnsmasq mtr nmap net-snmp openssl tcpdump && break; \
            [ $i -lt 3 ] && sleep $((i * 10)); \
        done; \
    fi && \
    if [ "$INSTALL_AWS_CLI" = "true" ]; then \
        for i in 1 2 3; do apk add --no-cache curl unzip bash && break; [ $i -lt 3 ] && sleep $((i * 10)); done; \
    fi && \
    if [ "$INSTALL_KUBECTL" = "true" ]; then \
        for i in 1 2 3; do apk add --no-cache kubectl-1.36-default && break; [ $i -lt 3 ] && sleep $((i * 10)); done; \
    fi && \
    apk upgrade --no-cache

# Install AWS CLI v2 (opt-in: --build-arg INSTALL_AWS_CLI=true)
RUN if [ "$INSTALL_AWS_CLI" = "true" ]; then \
        ARCH=$(uname -m) && \
        if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then \
            AWS_URL="https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip"; \
        else \
            AWS_URL="https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip"; \
        fi && \
        for i in 1 2 3 4 5; do \
            curl -sL --connect-timeout 30 --max-time 300 --retry 3 --retry-all-errors --retry-delay 5 "$AWS_URL" -o "awscliv2.zip" && break; \
            echo "Download attempt $i/5 failed, retrying..."; \
            sleep $((i * 10)); \
        done && \
        [ -s awscliv2.zip ] || (echo "Failed to download AWS CLI after 5 attempts" && exit 1) && \
        unzip -q awscliv2.zip && \
        ./aws/install && \
        rm -rf awscliv2.zip aws; \
    fi

# The builder stage uses python:3.13-slim which places Python at
# /usr/local/bin/python3.13; Wolfi places it at /usr/bin/python3.13.
# These symlinks keep the venv's internal python symlinks from breaking.
RUN mkdir -p /usr/local/bin \
    && ln -sf /usr/bin/python3.13 /usr/local/bin/python3.13 \
    && ln -sf /usr/bin/python3.13 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.13 /usr/local/bin/python

# Create appuser in final image
RUN groupadd -r appuser && useradd -r -g appuser -u 1001 -m appuser

# Mirror the source layout used in the builder stage so relative source
# dependencies such as `../common/mcp-auth` still resolve at runtime. Keep the
# venv outside /app so dev source mounts cannot hide installed dependencies.
ENV UV_PROJECT_ENVIRONMENT=/opt/caipe-mcp-venvs/${AGENT_NAME} \
    PATH="/opt/caipe-mcp-venvs/${AGENT_NAME}/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AGENT_NAME=${AGENT_NAME}

WORKDIR /app/ai_platform_engineering/mcp/${AGENT_NAME}

# Copy venv & code from builder (whole /app to preserve the mcp/common/
# sibling directory referenced by the editable mcp-agent-auth package).
COPY --from=builder --chown=appuser:appuser /opt/caipe-mcp-venvs /opt/caipe-mcp-venvs
COPY --from=builder --chown=appuser:appuser /app /app

USER appuser

EXPOSE 8000

# Run the HTTP/SSE MCP server. The flat module layout (server.py at the
# project root, package = false) is launched directly rather than as a module.
CMD ["sh", "-c", "exec python server.py"]
