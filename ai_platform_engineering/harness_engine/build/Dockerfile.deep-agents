FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder
WORKDIR /app/ai_platform_engineering/harness_engine
COPY ai_platform_engineering/harness_engine ./
COPY ai_platform_engineering/dynamic_agents ../dynamic_agents
COPY ai_platform_engineering/llm_wrapper ../llm_wrapper
RUN uv sync --frozen --no-dev --extra deep-agents

FROM python:3.14-slim-bookworm
WORKDIR /app/ai_platform_engineering/harness_engine
COPY --from=builder /app /app
RUN mkdir -p /var/lib/caipe-attachments && chown 65532:65532 /var/lib/caipe-attachments
ENV PATH="/app/ai_platform_engineering/harness_engine/.venv/bin:${PATH}" \
    HARNESS_ENGINE_DEEP_AGENTS_ENABLED="true" \
    HARNESS_ENGINE_HOST="0.0.0.0" \
    HARNESS_ENGINE_PORT="8010"
USER 65532:65532
EXPOSE 8010
CMD ["python", "-m", "harness_engine.main"]
