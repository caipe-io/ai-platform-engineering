SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=11111111-1111-1111-1111-111111111111
SHAREPOINT_CLIENT_SECRET=replace-with-a-secret-from-your-secret-manager
SHAREPOINT_SITE_URL=https://example.sharepoint.com/sites/example

SHAREPOINT_REQUEST_TIMEOUT_SECONDS=30
SHAREPOINT_MAX_DOWNLOAD_BYTES=2000000

MCP_MODE=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Direct HTTP deployments should use shared_key or oauth2. When CAIPE
# AgentGateway is the policy-enforcement point, leave this as none.
MCP_AUTH_MODE=none
