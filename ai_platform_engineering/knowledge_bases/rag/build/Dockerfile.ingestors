# First, build the application in the `/app` directory.
# See `Dockerfile` for details.
FROM ghcr.io/astral-sh/uv:0.12.6-python3.14-trixie-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Disable Python downloads, because we want to use the system interpreter
# across both images. If using a managed Python version, it needs to be
# copied from the build image into the final image; see `standalone.Dockerfile`
# for an example.
ENV UV_PYTHON_DOWNLOADS=0

# Build variant: "default" (with Playwright/Chromium for JS rendering) or "slim" (no Playwright, smaller image)
ARG VARIANT=default

# Copy over the local dependencies (excluding .venv directories)
COPY common /app/common
# Remove any .venv from common that shouldn't be in the image
RUN rm -rf /app/common/.venv

WORKDIR /app/ingestors
# Install dependencies based on variant
# Default includes Playwright for JS rendering; slim variant excludes it for smaller image
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=ingestors/uv.lock,target=uv.lock \
    --mount=type=bind,source=ingestors/pyproject.toml,target=pyproject.toml \
    if [ "$VARIANT" = "slim" ]; then \
        UV_HTTP_TIMEOUT=900 uv sync --locked --no-install-project --no-dev; \
    else \
        UV_HTTP_TIMEOUT=900 uv sync --locked --no-install-project --no-dev --extra playwright; \
    fi

COPY ingestors .
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$VARIANT" = "slim" ]; then \
        UV_HTTP_TIMEOUT=900 uv sync --locked --no-dev; \
    else \
        UV_HTTP_TIMEOUT=900 uv sync --locked --no-dev --extra playwright; \
    fi

# Clean up .venv to reduce image size (remove ~100MB of unnecessary files)
RUN find /app/ingestors/.venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /app/ingestors/.venv -type d -name "tests" -exec rm -rf {} + 2>/dev/null || true && \
    find /app/ingestors/.venv -type d -name "test" -exec rm -rf {} + 2>/dev/null || true && \
    find /app/ingestors/.venv -type f -name "*.pyi" -delete 2>/dev/null || true && \
    rm -rf /app/ingestors/.venv/include 2>/dev/null || true


# The final image uses a minimal, continuously patched Wolfi runtime without uv.
# Wolfi's CPython 3.14 remains ABI-compatible with the builder's manylinux wheels.
FROM cgr.dev/chainguard/wolfi-base

# Re-declare ARG after FROM to make it available in this stage
ARG VARIANT=default

# Install system dependencies from the Wolfi package repository:
# - python-3.14            : system CPython matching the builder
# - ca-certificates-bundle : TLS trust store
# - aws-cli-2              : EKS authentication using the patched system Python
# - bash                   : login shell for the non-root user
# - shadow                 : provides groupadd/useradd for non-root user creation
# - Playwright Chromium    : a maintained Chromium build matching the pinned
#                            Playwright client for JavaScript rendering.
RUN echo "https://packages.wolfi.dev/os" > /etc/apk/repositories && \
    apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache \
        python-3.14 \
        ca-certificates-bundle \
        aws-cli-2 \
        bash \
        shadow && \
    # Ensure /usr/local/bin/python3 (the path baked into the builder venv) exists
    if [ ! -e /usr/local/bin/python3 ]; then \
        mkdir -p /usr/local/bin && \
        ln -sf "$(command -v python3.14 || command -v python3)" /usr/local/bin/python3; \
    fi && \
    ln -sf /usr/local/bin/python3 /usr/local/bin/python

# Create a non-root user
RUN groupadd --gid 1001 app && \
    useradd --uid 1001 --gid app --shell /bin/bash --create-home app

# Copy the application from the builder
COPY --from=builder --chown=app:app /app /app

WORKDIR /app/ingestors

# Place executables in the environment at the front of the path
ENV PATH="/app/ingestors/.venv/bin:$PATH"

# Install the Chromium build matching the pinned Playwright client. Wolfi's
# Chromium package can lag its security fixes, while this browser is released
# and maintained together with Playwright for both supported architectures.
# These Wolfi libraries provide Chromium's GTK, graphics, font, and NSS runtime
# without installing Wolfi's separately versioned Chromium package.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN if [ "$VARIANT" != "slim" ]; then \
        apk add --no-cache \
            font-opensans \
            fontconfig \
            gtk-3 \
            libnss \
            mesa \
            mesa-glx \
            nss && \
        playwright install chromium; \
    fi

# Use a non-root user to run the application
USER app

# Run the application by default - use shell form to enable variable expansion
CMD python3 src/ingestors/${INGESTOR_TYPE}/ingestor.py
