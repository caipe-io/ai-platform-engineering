{
  "name": "@caipe-io/app-sdk",
  "version": "2.0.0-rc.1",
  "description": "CAIPE application manifests, host interfaces, and conformance checks for native and hosted apps",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caipe-io/ai-platform-engineering.git",
    "directory": "ui/app-sdk"
  },
  "homepage": "https://github.com/caipe-io/ai-platform-engineering/tree/main/ui/app-sdk#readme",
  "bugs": { "url": "https://github.com/caipe-io/ai-platform-engineering/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org", "tag": "next" },
  "engines": { "node": ">=24.11.0 <25" },
  "files": ["index.d.ts", "index.mjs", "checker.mjs", "contract-version.mjs", "contract-version.d.mts", "agentic-app-manifest.mjs", "agentic-app-manifest.d.mts", "native-manifest.d.mts", "reserved-paths.mjs", "iframe-bridge.mjs", "iframe-bridge.d.mts", "bin"],
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.mjs" },
    "./iframe-bridge": { "types": "./iframe-bridge.d.mts", "default": "./iframe-bridge.mjs" },
    "./checker": "./checker.mjs",
    "./contract-version": { "types": "./contract-version.d.mts", "default": "./contract-version.mjs" },
    "./manifest-contract": { "types": "./agentic-app-manifest.d.mts", "default": "./agentic-app-manifest.mjs" }
  },
  "bin": { "caipe-native-check": "bin/check.mjs", "caipe-app-check": "bin/check-manifest.mjs" }
}
