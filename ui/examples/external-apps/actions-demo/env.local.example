# Values for ui/.env.local when running `npm run dev` against the Actions Demo app.
# Local development only: this bypasses SSO and authorization checks.

SSO_ENABLED=false
NEXT_PUBLIC_SSO_ENABLED=false
ALLOW_DEV_ADMIN_WHEN_SSO_DISABLED=true
CAIPE_UNSAFE_RBAC_BYPASS=true

# The host also asks OpenFGA which teams a user belongs to when it lists agents,
# and the bypass flag does not cover that call. See README.md step 3.
OPENFGA_HTTP=http://127.0.0.1:18080

# Signs the session cookie that mint-session.mjs creates. At least 32 bytes.
NEXTAUTH_SECRET=replace-with-another-local-secret-of-at-least-32-bytes
NEXTAUTH_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=caipe
NEXT_PUBLIC_MONGODB_ENABLED=true

AGENTIC_APPS_INSTALL_ENABLED=true
AGENTIC_APPS_CONFIG_PATH=examples/external-apps/actions-demo/agentic-apps.yaml
# Use the same value when starting the demo app. At least 32 bytes.
AGENTIC_APP_TOKEN_SECRET=replace-with-a-local-secret-of-at-least-32-bytes
