# Message actions demo: automates the steps in README.md.
# Local development only. Needs Docker, Node 24, openssl and GNU make (3.81 or newer).

SHELL := /bin/bash
UI_DIR := ../../..
ENV_LOCAL := $(UI_DIR)/.env.local
# Marks a ui/.env.local this Makefile wrote, so `make clean` never removes one you wrote yourself.
MARKER := Generated by examples/external-apps/actions-demo (make env)
COMPOSE := docker compose
# Reads the session-signing secret that `make env` wrote.
AUTH_SECRET = $$(sed -n 's/^NEXTAUTH_SECRET=//p' .env)

.DEFAULT_GOAL := help
.PHONY: help setup env deps up seed dev session check test logs ps down clean

help: ## Show this help
	@echo "First run:  make setup, then make dev in a second terminal, then make session"
	@echo
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  make %-9s %s\n", $$1, $$2}'

setup: env deps up seed ## Create config, start the containers and seed the agent
	@echo
	@echo "Ready. Next:"
	@echo "  1. make dev      (second terminal: starts the host on http://localhost:3000)"
	@echo "  2. make session  (prints the session cookie for the browser)"
	@echo "  3. open http://localhost:3000/apps/actions-demo, or run make check"

.env:
	@printf 'AGENTIC_APP_TOKEN_SECRET=%s\nNEXTAUTH_SECRET=%s\n' "$$(openssl rand -hex 24)" "$$(openssl rand -hex 24)" > $@
	@chmod 600 $@
	@echo "wrote .env"

env: .env ## Write .env and ui/.env.local with fresh local secrets (never overwrites)
	@if [ -e $(ENV_LOCAL) ] && ! grep -q '$(MARKER)' $(ENV_LOCAL); then \
	  echo "$(ENV_LOCAL) already exists and was not written by this Makefile, so it is untouched."; \
	  echo "It must use the secrets in .env and the other settings in env.local.example."; \
	elif [ ! -e $(ENV_LOCAL) ]; then \
	  token=$$(sed -n 's/^AGENTIC_APP_TOKEN_SECRET=//p' .env); auth=$$(sed -n 's/^NEXTAUTH_SECRET=//p' .env); \
	  { echo '# $(MARKER)'; \
	    sed -e "s|^AGENTIC_APP_TOKEN_SECRET=.*|AGENTIC_APP_TOKEN_SECRET=$$token|" \
	        -e "s|^NEXTAUTH_SECRET=.*|NEXTAUTH_SECRET=$$auth|" env.local.example; } > $(ENV_LOCAL); \
	  chmod 600 $(ENV_LOCAL); \
	  echo "wrote $(ENV_LOCAL)"; \
	fi

deps: ## Install the UI dependencies if they are missing
	@[ -d $(UI_DIR)/node_modules ] || (cd $(UI_DIR) && npm ci)

# `up --wait` reports a finished one-shot container as a failure, so wait on the long-running services
# and run the OpenFGA model load as its own step.
up: env ## Start Mongo, OpenFGA (with its model) and the demo app
	$(COMPOSE) up -d --wait mongo openfga actions-demo
	$(COMPOSE) run --rm --no-deps openfga-init

seed: deps ## Create the placeholder agent in Mongo (run after `make up`)
	node seed-agent.mjs

dev: env deps ## Run the host UI in dev mode on http://localhost:3000 (stays in the foreground)
	@if (echo > /dev/tcp/127.0.0.1/3000) 2>/dev/null; then \
	  echo "Port 3000 is already in use, and Next.js allows one dev server per project."; \
	  echo "A dev server for ui/ that is already running picks up ui/.env.local on its own, so you can skip this step."; \
	  exit 1; \
	fi
	cd $(UI_DIR) && npm run dev

session: env deps ## Print a session cookie to add in the browser as next-auth.session-token
	@NEXTAUTH_SECRET=$(AUTH_SECRET) node mint-session.mjs

check: env deps ## Drive the real UI in headless Chrome (needs make up, seed and dev running)
	NEXTAUTH_SECRET=$(AUTH_SECRET) node check-ui.mjs

test: ## Run the demo app's unit tests
	node --test test/*.test.mjs

logs: ## Follow the container logs
	AGENTIC_APP_TOKEN_SECRET=$${AGENTIC_APP_TOKEN_SECRET:-unused} $(COMPOSE) logs -f

ps: ## Show the containers
	AGENTIC_APP_TOKEN_SECRET=$${AGENTIC_APP_TOKEN_SECRET:-unused} $(COMPOSE) ps

down: ## Stop and remove the containers (keeps .env and ui/.env.local)
	AGENTIC_APP_TOKEN_SECRET=$${AGENTIC_APP_TOKEN_SECRET:-unused} $(COMPOSE) down --remove-orphans

clean: ## Remove the containers and the files `make env` wrote
	AGENTIC_APP_TOKEN_SECRET=$${AGENTIC_APP_TOKEN_SECRET:-unused} $(COMPOSE) down --volumes --remove-orphans
	rm -f .env
	@if [ -e $(ENV_LOCAL) ] && grep -q '$(MARKER)' $(ENV_LOCAL); then rm -f $(ENV_LOCAL); echo "removed $(ENV_LOCAL)"; fi
